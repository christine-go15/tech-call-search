# Copy this file to .env.local and fill in your real values.
# Never commit .env.local to GitHub.

# From Neon: Dashboard > your project > Connection Details > "Connection string"
DATABASE_URL=postgresql://user:password@your-project.neon.tech/neondb?sslmode=require

# From Google AI Studio: aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: override model names if Google renames/updates them later.
# Check aistudio.google.com for current available model names.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-flash-latest
